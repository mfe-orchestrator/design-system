{
    "name": "@mfe-orchestrator/design-system",
    "version": "0.1.0",
    "description": "Design System for MFE Orchestrator",
    "license": "Apache-2.0",
    "type": "module",
    "packageManager": "pnpm@10.19.0",
    "engines": {
        "node": ">=21.0.0"
    },
    "files": ["dist"],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./theme.css": "./dist/theme.css",
        "./package.json": "./package.json"
    },
    "sideEffects": ["**/*.css"],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mfe-orchestrator/design-system.git"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint --write ./src",
        "format": "biome format --write ./src"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.2.16",
        "@radix-ui/react-avatar": "^1.2.2",
        "@radix-ui/react-checkbox": "^1.3.7",
        "@radix-ui/react-dialog": "^1.1.19",
        "@radix-ui/react-dropdown-menu": "^2.1.20",
        "@radix-ui/react-label": "^2.1.11",
        "@radix-ui/react-popover": "^1.1.19",
        "@radix-ui/react-radio-group": "^1.4.3",
        "@radix-ui/react-select": "^2.3.3",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-switch": "^1.3.3",
        "@radix-ui/react-tabs": "^1.1.17",
        "@radix-ui/react-toggle": "^1.1.14",
        "@radix-ui/react-toggle-group": "^1.1.15",
        "@radix-ui/react-tooltip": "^1.2.12",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.24.0",
        "react-day-picker": "^10.0.1",
        "react-pick-color": "^2.1.0",
        "tailwind-merge": "^3.6.0"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "react-hook-form": "^7.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.3",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^4.3.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-hook-form": "^7.81.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.4",
        "vite-plugin-dts": "^4.5.4"
    }
}
